# Copy to .env.local and fill in values (never commit .env.local)

# Telegram — lead notifications from /api/submit-lead
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Yango Deli CRM — forward leads to the recruitment CRM (in addition to Telegram)
# CRM_API_URL: CRM base URL (used to load open stores/cities for forms)
# CRM_INTAKE_URL: full URL of the CRM webhook, e.g. https://delicrm.com/api/recruitment/webhook
# CRM_WEBHOOK_SECRET: must match RECRUITMENT_WEBHOOK_SECRET in the CRM
CRM_API_URL=
CRM_INTAKE_URL=
CRM_WEBHOOK_SECRET=

# Optional: Zoho webhook (if enabled)
# ZOHO_WEBHOOK_SECRET=

# Optional: WordPress asset sync (scripts only)
# WP_URL=
# WP_USER=
# WP_APP_PASSWORD=
